+/* General Control Packet (GCP) slot, NVD5.x SF-HDMI aperture (per-head
+ * stride 0x400, matching the working AVI slot at +0x00 and VSI at +0x100).
+ * Register layout bit-matches NVIDIA's own class header
+ * NV9171_SF_HDMI_GCP_SUBPACK: SB0 bits 7:0, SB1 bits 15:8, SB2 bits 23:16.
+ * Payload fields reproduce the proprietary driver's construction
+ * (open-gpu-kernel-modules, nvkms-hdmi.c SendHdmiGcp()): SB0 = 0x10
+ * (Clear_AVMUTE), SB1 = CD | PP << 4, SB2 = 0 (reset default packing phase).
+ */
+void
+gv100_sor_hdmi_gcp(struct nvkm_ior *ior, int head, u8 cd, u8 pp)
+{
+	struct nvkm_device *device = ior->disp->engine.subdev.device;
+	const u32 hdmi = head * 0x400;
+	const u32 subpack = 0x00000010 | (cd << 8) | (pp << 12);
+
+	nvkm_mask(device, 0x6f00c0 + hdmi, 0x00000001, 0x00000000);
+	nvkm_wr32(device, 0x6f00cc + hdmi, subpack);
+	nvkm_mask(device, 0x6f00c0 + hdmi, 0x00000001, 0x00000001);
+
+	/* Experimental instrumentation (runs 4+): prove whether the CPU-side
+	 * MMIO write sticks under GSP, and cross-check the sibling AVI slot
+	 * at the same aperture.  Read-only.
+	 */
+	nvkm_warn(&ior->disp->engine.subdev,
+		  "gcp: head %d subpack w=0x%08x r=0x%08x ctrl=0x%08x avi_ctrl=0x%08x avi_sp0=0x%08x\n",
+		  head, subpack,
+		  nvkm_rd32(device, 0x6f00cc + hdmi),
+		  nvkm_rd32(device, 0x6f00c0 + hdmi),
+		  nvkm_rd32(device, 0x6f0000 + hdmi),
+		  nvkm_rd32(device, 0x6f000c + hdmi));
+}
