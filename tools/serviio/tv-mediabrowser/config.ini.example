# tv-mediabrowser configuration — copy to config.ini next to server.py
# (or point BRAVIA_CONFIG=/path at it). Everything host- and install-
# specific lives here, so the app itself is install-agnostic.
#
# Precedence per option: environment variable > this file > built-in
# default. SERVIIO= and MEDIA_ROOTS= env vars still override, which
# keeps the test batteries env-driven.

[app]
# where this app listens. The systemd unit passes its own port on the
# command line, which still wins over this file.
bind_host = 0.0.0.0
port = 8090

[serviio]
# the Serviio media server this app browses/proxies
host = 192.168.0.60
port = 8895

[library]
# mounted media roots, colon-separated, audio first (the duration-index
# probe pass walks them in order; audio is small and finishes while
# video replays from the persisted cache). Only existing dirs are used.
roots = /mnt/arquivos2/Música:/mnt/arquivos2/Vídeos
# transcode/art/probe cache (defaults to <app dir>/cache)
# cache_dir = /var/cache/bravia-mediabrowser

[keys]
# Remote multimedia-key codes: which keyCodes the TV's era browser
# reports for the remote's transport buttons.
#
# MEASURED on a KDL-46EX725 (AZ2-F) 2026-09-18, and the answer is that
# there are none. The remote's PLAY, PAUSE, STOP, PREV and NEXT buttons
# produce NO keydown event at all — 15 KEYPROBE captures at /keys yielded
# only 37, 38, 39, 40 and 13. The values below are the original
# Android-TV guess, kept only so the config shape stays documented; on
# this generation they are inert.
#
# What the browser actually receives:
#   13 = OK/confirm       38 = up          40 = down
#   37 = left  AND the remote's REW button (same code)
#   39 = right AND the remote's FF button  (same code)
# All four colour keys belong to Opera and never reach the page (the
# browser says so in its status line while a link loads):
#   GREEN = history back    YELLOW = history forward  (between pages)
#   RED   = bottom of page   BLUE   = top of page      (within a page)
# None of them is bindable by an app on this generation.
#
# This is why the on-screen transport bar exists: it is not a stopgap
# until the media keys are mapped, it is the only transport the platform
# can give an app. See docs/era-key-vocabulary.md.
#
# Your set may differ: /keys shows each code on screen and logs it as a
# KEYPROBE line in server.log. Comma-separate for aliases; 0 disables.
playpause = 85
play = 126
pause = 127
stop = 86
prev = 88
next = 87
rew = 89
ff = 90