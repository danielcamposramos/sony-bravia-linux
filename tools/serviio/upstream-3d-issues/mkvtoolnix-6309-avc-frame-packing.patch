+void
+qtmp4_demuxer_c::derive_stereo_mode_from_avc_bitstream() {
+  // The frame packing arrangement is signalled only in an SEI message inside
+  // the bitstream, never in the avcC, so look at the first frames even when
+  // the decoder configuration is present. Doing it here means the result is
+  // known during file identification already.
+  if (priv.empty() || (5 > priv[0]->get_size()))
+    return;
+
+  auto mem = read_first_bytes(10'000);
+  if (!mem)
+    return;
+
+  mtx::avc::es_parser_c parser;
+
+  parser.set_configuration_record(priv[0]);
+  parser.add_bytes_framed(mem, (priv[0]->get_buffer()[4] & 0x03) + 1);
+  parser.flush();
+
+  v_stereo_mode = parser.get_stereo_mode();
+
+  mxdebug_if(m_debug_headers, fmt::format("derive_stereo_mode_from_avc_bitstream: stereo mode from frame packing SEI: {0}\n", v_stereo_mode ? static_cast<int>(*v_stereo_mode) : -1));
