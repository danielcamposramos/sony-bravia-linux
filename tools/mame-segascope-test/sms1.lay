<?xml version="1.0"?>
<!--
  Half side-by-side view for the SegaScope 3-D Glasses, for display on a 3D
  television. This is the layout proposed by darkfalz79 in
  https://github.com/mamedev/mame/issues/3492 (open since 2018-04-27),
  reproduced here verbatim in order to test it, not as our own work.

  MAME's SMS driver exposes the shutter glasses as separate screens, which is
  the "kludge" the issue's author acknowledges and which a reply in the thread
  objects to on the grounds that they are electronic shutters rather than three
  physical screens. That objection is about the driver, not about this layout.
-->
<mamelayout version="2">
	<view name="SegaScope 3-D Glasses (3DTV H-SBS)">
		<screen index="1">
			<bounds x="2" y="0" width="6" height="9" />
		</screen>
		<screen index="2">
			<bounds x="10" y="0" width="6" height="9" />
		</screen>
	</view>
</mamelayout>
