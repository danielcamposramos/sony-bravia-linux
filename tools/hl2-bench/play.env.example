# Example play profile for game-wrap.sh: Daniel's exact working launch of the
# in-game 3D version (source-sdk-2013 branch stereo3d-sbs-native, module
# 5db63a08), from Steam's Play button, 2026-09-26. game-wrap.sh reads it from
# /K3D/temp/hl2-bench/play.env when no suite run is on; copy it there (or
# change that path in game-wrap.sh) and adjust the paths and the GPU lines
# to your machine. It is the q17 suite launch without the bench parts.
STEP_OUT=/K3D/temp/hl2-bench/play
STEP_ARGS="-vulkan -novid -w 1920 -h 1080 -fullscreen -gamepadui +sv_cheats 1 +viewmodel_fov 90"
# The module's 2D size, as every suite run gave it.
SVRTV_WIDTH=1920
SVRTV_HEIGHT=1080
# gamescope-3dtv (nested present mode immediate), on the RTX 3060, on HDMI-A-1.
# No -S stretch.
SVRTV_GAMESCOPE_BIN="$HOME/.local/bin/gamescope-3dtv"
SVRTV_GAMESCOPE="--backend sdl -g --prefer-vk-device 10de:2504 -f -W 1920 -H 1080 -w 1920 -h 1080 --display-index 0"
__NV_PRIME_RENDER_OFFLOAD=1
__GLX_VENDOR_LIBRARY_NAME=nvidia
__VK_LAYER_NV_optimus=NVIDIA_only
# The game free-runs (the gamescope frame-race cure).
DXVK_CONFIG="d3d9.presentInterval = 0"
