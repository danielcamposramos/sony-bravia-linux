# Example play profile for game-wrap.sh: Daniel's exact working launch of the
# in-game 3D version (source-sdk-2013 branch stereo3d-full-res-wip, module
# ed82a30e: full-size eyes, full top and bottom the default, one menu entry
# per setting), from Steam's Play button, native since 2026-09-28 (run q26,
# "perfection"). game-wrap.sh reads it from /K3D/temp/hl2-bench/play.env when
# no suite run is on; copy it there (or change that path in game-wrap.sh) and
# adjust the paths and the GPU lines to your machine. It is the suite's native
# launch without the bench parts.
#
# Natively, HL2 opens on the screen with the mouse (-displayindex is not
# followed on KDE Plasma), so a KWin window rule places it on the 3D TV
# (System Settings > Window Management > Window Rules, or ~/.config/kwinrulesrc):
# window class ^hl2_linux$ (regular expression), position forced to the TV's
# origin, fullscreen forced, accept focus forced.
STEP_OUT=/K3D/temp/hl2-bench/play
# sv_cheats 1 + viewmodel_fov 90: the muzzle sprite on the muzzle (no
# achievements while cheats are on).
STEP_ARGS="-vulkan -novid -w 1920 -h 1080 -fullscreen -displayindex 0 -gamepadui +sv_cheats 1 +viewmodel_fov 90"
# The module's 2D size, as every suite run gave it.
SVRTV_WIDTH=1920
SVRTV_HEIGHT=1080
# On the RTX 3060 (the desktop runs on the AMD iGPU).
__NV_PRIME_RENDER_OFFLOAD=1
__GLX_VENDOR_LIBRARY_NAME=nvidia
__VK_LAYER_NV_optimus=NVIDIA_only
# Natively the game keeps vsync (DXVK present interval 1), as in run q26.
DXVK_CONFIG="d3d9.presentInterval = 1"

# Through gamescope instead (the anaglyph, rows and checkerboard outputs,
# run q27): gamescope-3dtv (nested present mode immediate), no -S stretch, and
# the game free-running (the gamescope frame-race cure). Replace the last line
# above with these three:
# SVRTV_GAMESCOPE_BIN="$HOME/.local/bin/gamescope-3dtv"
# SVRTV_GAMESCOPE="--backend sdl -g --prefer-vk-device 10de:2504 -f -W 1920 -H 1080 -w 1920 -h 1080 --display-index 0"
# DXVK_CONFIG="d3d9.presentInterval = 0"
